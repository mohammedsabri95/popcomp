cff-version: 1.2.0

message: "If you use popcomp in your research, please cite this software."

type: software

title: "popcomp: Bayesian Count Models for Population-Referenced Compositions"

version: "0.1.0"

authors:
  - family-names: Sabri
    given-names: Mohammed
    affiliation: "King Abdullah University of Science and Technology (KAUST), Saudi Arabia"
    email: mohammed.sabri@kaust.edu.sa

repository-code: "https://github.com/mohammedsabri95/popcomp"

url: "https://github.com/mohammedsabri95/popcomp"

abstract: >-
  An R package for Bayesian count modelling and posterior
  distributional contrasts for population-referenced compositions,
  incorporating spatial random effects, Wasserstein-1 distances,
  and tolerance-based inference.

keywords:
  - Bayesian statistics
  - Compositional data
  - Spatial statistics
  - Wasserstein distance
  - Distributional regression
  - Bayesian inference

license: MIT
